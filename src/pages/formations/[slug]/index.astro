---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const parcours = await getCollection('parcours');
  return parcours.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(p);
const modules = (await getCollection('modules'))
  .filter((m) => m.data.parcours === p.id)
  .sort((x, y) => x.data.order - y.data.order);
---
<Base title={p.data.title} description={p.data.summary} noindex={modules.length === 0}>
  <h1>{p.data.title}</h1>
  <p>{p.data.summary}</p>
  <Content />
  {modules.length === 0 ? (
    <p class="muted">Contenu à venir.</p>
  ) : (
    <ol class="parcours">
      {modules.map((m) => (
        <li>
          <a href={`${b}/formations/${p.id}/${m.id}/`}>
            <span class="num">{m.data.order}</span>
            <span><strong>{m.data.title}</strong></span>
            <span class="muted">{m.data.access}</span>
          </a>
        </li>
      ))}
    </ol>
  )}
</Base>
