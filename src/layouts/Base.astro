---
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = 'Formations en systèmes embarqués automobiles.', noindex = false } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const full = title ? `${title} – SysAuto Formations` : 'SysAuto Formations';
const nav = [['Formations', '/formations/'], ['Ressources', '/ressources/'], ['À propos', '/a-propos/'], ['Contact', '/contact/']];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="56DWMlV_Rq0e9Bk1M1t0a-zvIEmgb6R3hUJd3Xq0rX4" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${b}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <header>
      <a class="brand" href={`${b}/`}>SysAuto Formations</a>
      <nav>{nav.map(([label, href]) => <a href={`${b}${href}`}>{label}</a>)}</nav>
    </header>
    <main><slot /></main>
    <footer><a href={`${b}/mentions-legales/`}>Mentions légales</a></footer>
  </body>
</html>